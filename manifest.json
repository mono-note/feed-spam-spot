{
  "manifest_version": 3,
  "name": "Feed Spam Spotter",
  "version": "0.1.0",
  "description": "Label ads, spam, sales and affiliate posts on X and Facebook using TypeSafe Jev",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.facebook.com/*"], "js": ["content.js"] }
  ]
}
